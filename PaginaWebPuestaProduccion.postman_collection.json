      "name": "IntentoCorrectoLogin",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Limpia las cookies para asegurar que cada intento de login sea 'fresco'\r",
              "pm.cookies.clear();"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. Ver qué está pasando realmente (Mira la consola de Postman con Ctrl+Alt+C)\r",
              "console.log(\"Contenido recibido:\", pm.response.text());\r",
              "\r",
              "pm.test(\"Estado de respuesta es 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// 2. Comprobar si estamos en el Dashboard o seguimos en el Login\r",
              "pm.test(\"¿Estamos en el Dashboard?\", function () {\r",
              "    var body = pm.response.text();\r",
              "    // Comprobamos si el HTML contiene el título del Dashboard\r",
              "    // Si falla aquí, es que el login ha fallado en el servidor\r",
              "    pm.expect(body).to.include(\"Mi Lista de Compra\");\r",
              "});\r",
              "\r",
              "// 3. Comprobar el usuario\r",
              "pm.test(\"¿Aparece Rigoberto23 en el HTML?\", function () {\r",
              "    var body = pm.response.text();\r",
              "    pm.expect(body).to.include(\"Rigoberto23\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
