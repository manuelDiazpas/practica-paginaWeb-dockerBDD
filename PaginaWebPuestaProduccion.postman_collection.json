    {
      "name": "IntentoFallidoLogin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. El código es 200 porque Flask nos devuelve a la página de login\r",
              "pm.test(\"Status code is 200 (Login recargado)\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// 2. Verificar que NO entramos al Dashboard y seguimos en Login\r",
              "pm.test(\"Seguridad: El usuario permanece en la página de acceso\", function () {\r",
              "    var responseBody = pm.response.text();\r",
              "    pm.expect(responseBody).to.include(\"Iniciar Sesión\");\r",
              "    pm.expect(responseBody).to.not.include(\"products-grid\");\r",
              "});\r",
              "\r",
              "// 3. Verificar que aparece el mensaje de error de tu app.py\r",
              "pm.test(\"Seguridad: Se muestra el mensaje de error de Flask\", function () {\r",
              "    pm.expect(pm.response.text()).to.include(\"Usuario o contraseña incorrectos\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
