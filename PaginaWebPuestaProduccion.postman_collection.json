    {
      "name": "AñadirProductosEnLaLista",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. La respuesta es 200 porque Flask redirige y sigue al dashboard\r",
              "pm.test(\"Status 200 tras añadir producto\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// 2. Estamos en el dashboard, no en login\r",
              "pm.test(\"Redirige al Dashboard correctamente\", function () {\r",
              "    pm.expect(pm.response.text()).to.include(\"Mi Lista de Compra\");\r",
              "});\r",
              "\r",
              "// 3. El mensaje flash de éxito aparece\r",
              "pm.test(\"Mensaje de confirmación de producto añadido\", function () {\r",
              "    pm.expect(pm.response.text()).to.include(\"añadido correctamente\");\r",
              "});\r",
              "\r",
              "// 4. El panel de acciones sigue disponible\r",
              "pm.test(\"El formulario de añadir sigue presente\", function () {\r",
              "    pm.expect(pm.response.text()).to.include(\"Añadir a la lista\");\r",
              "});\r",
              "\r",
              "// 5. Guardar el HTML para debug\r",
              "console.log(\"Respuesta añadir:\", pm.response.text().substring(0, 500));"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
